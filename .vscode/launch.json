    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "chrome",
            "runtimeExecutable": "/usr/bin/brave-browser",
            "port": 9222,
            "request": "launch",
            "name": "open BrowserSync",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/src",
            "preLaunchTask": "lanzarBrowserSync",
            "postDebugTask": "apagarBrowserSync"
        },
        {
            "type": "chrome",
            "runtimeExecutable": "/usr/bin/brave-browser",
            "port": 9222,
            "request": "launch",
            "name": "debug BrowserSync",
            "url": "http://localhost:3000/test/tipoExamen_test.html",
            "webRoot": "${workspaceFolder}/",
            "preLaunchTask": "debugBrowserSync",
            "postDebugTask": "apagarBrowserSync"
        }
    ]
}