import tarjetaConsulta from './tarjeta_simple.js';
import consulta from '../../entity/consulta.js';
class TarjetaConsulta extends HTMLElement {
    constructor() {
        super();
        this.tarjetaConsulta = new tarjetaConsulta();
        this.consulta = new consulta();
        this.root = this.attachShadow({ mode: "open" });
    }

    connectedCallback() {
        //<p slot="titulo"></p>
        let titulo=document.createElement("p");
        titulo.setAttribute("slot","titulo");
        //remplazar el idConsulta por informacion importante
        titulo.innerText=this.consulta.idConsulta;
        
        let contenido=document.createElement("p");
        contenido.setAttribute("slot","contenido");
        contenido.innerText='paciente: ${this.consulta.idPersonalRol.identificadorPersona}, Clinica: ${this.Consulta.idPersonaRol.identificarClinica}';

        this.tarjeta.appendChild(titulo);
        this.tarjeta.appendChild(contenido);


        this.root.appendChild(this.tarjeta);
    }

}

export default TarjetaConsulta;
customElements.define("tarjeta-consulta", TarjetaConsulta);
</file>

<file path="src/js/boundary/componentes/tarjeta_simple.js">
class TarjetaSimple  extends HTMLElement {
    constructor() {
        super();
        this.root=this.attachShadow({mode: "open"});
    }

    connectedCallback(){
        //<div class="header"> <slot name="titulo">agregar encabezado</slot> </div>
        let titulo=document.createElement("div");
        titulo.setAttribute("class","header");
        let slotTitulo=document.createElement("slot");
        slotTitulo.setAttribute("name","titulo");
        slotTitulo.innerText="agregar encabezado";
        titulo.appendChild(slotTitulo);

        let cuerpo=document.createElement("div");
        cuerpo.setAttribute("class","body");
        let slotCuerpo=document.createElement("slot");
        slotCuerpo.setAttribute("name","contenido");
        slotCuerpo.innerText="agregar contenido";
        cuerpo.appendChild(slotCuerpo);
        
        let pie=document.createElement("div");
        pie.setAttribute("class","footer");
        let slotPie=document.createElement("slot");
        slotPie.setAttribute("name","pie");
        slotPie.innerText="agregar pie";
        pie.appendChild(slotPie);

        this.root.appendChild(titulo);
        this.root.appendChild(cuerpo);
        this.root.appendChild(pie);
    }
}
customElements.define("tarjeta-simple", TarjetaSimple);
export default TarjetaSimple;
</file>

